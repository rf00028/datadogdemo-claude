# ── Required ─────────────────────────────────────────────────────────────────
# Your Datadog API key (from app.datadoghq.com → Organization Settings → API Keys)
DD_API_KEY=your_api_key_here

# Your Datadog Application key (from app.datadoghq.com → Organization Settings → Application Keys)
# Required for setup-datadog.js to create monitors, synthetics, and dashboards
DD_APP_KEY=your_app_key_here

# Anthropic API key — powers the in-app AI assistant + Datadog LLM Observability
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional (safe defaults shown) ───────────────────────────────────────────
# Datadog site (datadoghq.com for US1, datadoghq.eu for EU1, etc.)
DD_SITE=datadoghq.com

# Environment tag shown in Datadog UI
DD_ENV=local

# App version tag
DD_VERSION=1.0.0
